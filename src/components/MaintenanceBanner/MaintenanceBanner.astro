---
import getTranslatedContent from "@utils/directus";
import WarningIcon from "@icons/warning.svg?react";
import "./MaintenanceBanner.scss";

const { lang } = Astro.props

const content = await getTranslatedContent("Maintenance", lang);
let message: string | null = content.message;

if (typeof message === "string") {
  message = message.trim();
  if (message.length === 0) {
    message = null;
  }
} else {
  message = null;
}
---

{
  message && (
    <aside class="maintenance-banner" role="alert">
      <div class="maintenance-banner__content">
        <WarningIcon className="maintenance-banner__icon" />
        <span class="maintenance-banner__text">{message}</span>
      </div>
    </aside>
  )
}
