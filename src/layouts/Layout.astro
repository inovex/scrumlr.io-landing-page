---
import { detectLanguageFromUrl } from "@i18n/utils";
import Navbar from "@components/Navbar/Navbar.astro";
import Footer from "@components/Footer/Footer.astro";
import MaintenanceBanner from "@components/MaintenanceBanner/MaintenanceBanner.astro";
import "./Layout.scss"

export interface Props {
  title: string;
}

const { title } = Astro.props;
const lang = detectLanguageFromUrl(Astro.url);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="description"
      content="Open source online retrospective & collaboration tool - fast onboarding, jump right into a session with your team"
    />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1 viewport-fit=cover"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <script
      defer
      data-domain="scrumlr.io"
      src="https://inolytics.inovex-gpt.fra.ics.inovex.io/js/script.js"
    ></script>
  </head>
  <body>
    <div class="body_wrapper">
      <header class="header_wrapper">
        <MaintenanceBanner lang={lang} />
        <Navbar lang={lang} />
      </header>
      <main>
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
  </body>
</html>
